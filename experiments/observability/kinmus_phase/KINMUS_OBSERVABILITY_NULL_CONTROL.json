{
  "branch_id": "S6-KINMUS-TASK-OBSERVABILITY",
  "plan_sha256": "19da16a52d11ad1591a456ac19d8863faa1c185e84ae7ed3521236a7faab3141",
  "protocol": {
    "grouping": "subject",
    "protocol": "grouped 5-fold cross-validation over the 22 subjects",
    "fold_assignment": "folds are assigned by sorting subject ids and dealing round-robin (subject 1 -> fold 1, ..., subject 5 -> fold 5, subject 6 -> fold 1, ...). Deterministic, no shuffling, frozen here.  Fold sizes are 5,5,4,4,4",
    "no_row_wise_split": true,
    "no_trial_split": "a trial is one phase segment and belongs wholly to one subject, so trials can never be split across folds",
    "no_subject_leakage": "asserted at run time: the intersection of train and test subject sets is empty in every fold, and the union is all 22 subjects",
    "normalization": "TRAIN-FOLD ONLY z-scoring: mean and SD are computed on the training subjects of that fold and applied unchanged to the held-out subject.  A held-out subject is never normalized using its own statistics",
    "primary_setting": "zero-shot new-subject evaluation, no target-subject calibration"
  },
  "evaluation_stratum": "INTERIOR",
  "boundary_margin_frames": 20,
  "model_configurations": {
    "PRIMARY": {
      "A_LDA": "LinearDiscriminantAnalysis(solver='lsqr', shrinkage='auto') on the train-fold z-scored features - the project's own frozen closed-set baseline configuration",
      "B_MULTINOMIAL_LR": "LogisticRegression(multi_class='multinomial', solver='lbfgs', max_iter=2000, C=1.0) on the same features"
    },
    "SECONDARY": {
      "C_LINEAR_SVM": "LinearSVC(C=1.0) or SVC(kernel='linear', C=1.0)",
      "D_RBF_SVM": "SVC(kernel='rbf', C=1.0, gamma='scale')"
    },
    "directly_not_used": [
      "neural networks of any kind",
      "Transformers",
      "random architecture search",
      "XGBoost",
      "AutoML",
      "ensembles",
      "deep temporal models",
      "any hyperparameter grid"
    ],
    "no_hyperparameter_search": "every model is used at ONE frozen configuration.  The point is task observability, not classifier innovation.  If simple models cannot read the signal, the task is not immediately rescued with a large model"
  },
  "no_hyperparameter_search": "every model is used at ONE frozen configuration.  The point is task observability, not classifier innovation.  If simple models cannot read the signal, the task is not immediately rescued with a large model",
  "notes": [
    "balanced accuracy is the primary metric",
    "all numbers are subject-held-out",
    "normalisation statistics come from the training folds only"
  ],
  "artifact": "KINMUS_OBSERVABILITY_NULL_CONTROL.json",
  "why_mandatory": "randomly permuting individual frames would destroy the temporal autocorrelation too and produce an unrealistically EASY null, making the real result look better than it is",
  "schemes": {
    "N1_TRIAL_PERMUTATION": "permute the phase label at the TRIAL level within each subject: take that subject's 78 phase-segment labels and reassign them to its segments at random.  This destroys only the phase-to-pose correspondence, preserves the movement repertoire, and keeps every subject's 'reaching' and 'releasing' segments at their true lengths",
    "N2_CIRCULAR_SHIFT": "circularly shift the phase label within each subject's segments, rotating the label sequence while preserving the count structure"
  },
